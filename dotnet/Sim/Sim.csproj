<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shadow project. See Content.csproj. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Sim</AssemblyName>
    <RootNamespace>RTS.Sim</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Warnings are errors. They accumulate otherwise: this project reached 18 nullable
         warnings without anyone deciding to accept one, and CI surfaced them only once it
         existed. If an SDK bump introduces a new warning, that is a change worth reading. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Sim/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Content/Content.csproj" />
  </ItemGroup>

</Project>
